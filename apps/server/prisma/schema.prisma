generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ItemType {
  ASSIGNMENT
  DEADLINE
  SOCIAL_EVENT
  TASK
}

enum ItemStatus {
  PENDING
  DONE
}

enum AssignmentType {
  HOMEWORK
  QUIZ
  EXAM
  PROJECT
  OTHER
}

enum DeadlineCategory {
  WORK
  CLASS
  PERSONAL
  OTHER
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum RecurrenceEndCondition {
  NEVER
  ON_DATE
  AFTER_N_OCCURRENCES
}

enum Mood {
  GREAT
  GOOD
  NEUTRAL
  TIRED
  STRESSED
  SAD
}

enum AchievementType {
  SEVEN_DAY_STREAK
  EARLY_BIRD
  THIRTY_DAY_STREAK
  PERFECT_WEEK
}

model Item {
  id        String     @id @default(uuid())
  name      String
  startDate DateTime
  time      DateTime?
  status    ItemStatus
  type      ItemType

  recurrenceId String?     @unique
  recurrence   Recurrence? @relation(fields: [recurrenceId], references: [id])

  assignment  Assignment?
  deadline    Deadline?
  socialEvent SocialEvent?
}

model Assignment {
  id             String         @id
  assignmentType AssignmentType
  courseId       String?
  course         Course?        @relation(fields: [courseId], references: [id])

  item Item @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Deadline {
  id       String           @id
  category DeadlineCategory

  item Item @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Person {
  id     String        @id @default(uuid())
  name   String
  events SocialEvent[]
}

model SocialEvent {
  id       String   @id
  endDate  DateTime
  location String?
  invitees Person[]

  item Item @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Recurrence {
  id             String                 @id @default(uuid())
  frequency      RecurrenceFrequency
  interval       Int
  daysOfWeek     String?
  endCondition   RecurrenceEndCondition
  endDate        DateTime?
  occurrenceCount Int?
  time           DateTime?

  item   Item?
  course Course?
  habit  Habit?
}

model Course {
  id         String  @id @default(uuid())
  name       String
  instructor String?
  location   String?
  icon       String

  recurrenceId String     @unique
  recurrence   Recurrence @relation(fields: [recurrenceId], references: [id])

  assignments Assignment[]
}

model Habit {
  id            String @id @default(uuid())
  name          String
  currentStreak Int
  longestStreak Int
  targetQuantity Int?
  unit String?

  recurrenceId String     @unique
  recurrence   Recurrence @relation(fields: [recurrenceId], references: [id])

  completions  HabitCompletion[]
  achievements Achievement[]
}

model Achievement {
  id       String          @id @default(uuid())
  type     AchievementType
  earnedAt DateTime

  habitId String?
  habit   Habit?  @relation(fields: [habitId], references: [id])
}

model HabitCompletion {
  id          String   @id @default(uuid())
  completedAt DateTime
  quantity Int?

  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id])

  @@unique([habitId, completedAt])
}

model WeeklyRecap {
  id                  String   @id @default(uuid())
  weekStartDate       DateTime
  moodTrend           Mood?
  completionRate      Float
  tasksCompletedCount Int
  highlightPhoto      String?

  songInfoId String?   @unique
  songInfo   SongInfo? @relation(fields: [songInfoId], references: [id])

  highlights Highlight[]
}

model Highlight {
  id     String  @id @default(uuid())
  title  String
  detail String?
  icon   String

  weeklyRecapId String
  weeklyRecap   WeeklyRecap @relation(fields: [weeklyRecapId], references: [id], onDelete: Cascade)
}

model SongInfo {
  id           String       @id @default(uuid())
  spotifyId    String
  title        String
  artist       String
  albumArtUrl  String?

  dayEntry     DayEntry?
  weeklyRecap  WeeklyRecap?
}

model DayEntry {
  id         String    @id @default(uuid())
  date       DateTime
  mood       Mood?
  photo      String?

  songInfoId String?   @unique
  songInfo   SongInfo? @relation(fields: [songInfoId], references: [id])
}